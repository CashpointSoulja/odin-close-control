{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayo-odin-close-control",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "odin-close-control",
      // Replace this obvious placeholder after creating a real D1 database.
      // Local Wrangler development and migrations work without a remote database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
