{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayo-odin-close-control",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ODIN_SESSIONS", "class_name": "OdinSession" },
      { "name": "ODIN_RATE_LIMITERS", "class_name": "OdinRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "odin-sqlite-v1", "new_sqlite_classes": ["OdinSession", "OdinRateLimiter"] }
  ],
  "observability": {
    "enabled": false
  }
}
